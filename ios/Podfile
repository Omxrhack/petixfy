require 'fileutils'

platform :ios, '14.0'

# Si el proyecto está en ~/Documents (iCloud), macOS añade xattrs a los binarios en
# `build/native_assets/` y `codesign` falla. Flutter siempre usa `build/` relativo al
# proyecto para native_assets (no respeta FLUTTER_BUILD_DIR de Xcode). Redirigimos
# `build/` a ~/Library/Developer/... con un symlink cuando `build/` aún no existe.
def ensure_flutter_build_outside_icloud
  ios_dir = __dir__
  project_root = File.expand_path('..', ios_dir)
  build_path = File.join(project_root, 'build')
  target = File.join(Dir.home, 'Library', 'Developer', 'flutter_build', File.basename(project_root))

  if File.symlink?(build_path)
    return if File.realpath(build_path) == File.realpath(target)

    puts ''
    puts '[!] build/ es un symlink distinto al esperado. Para native_assets + iCloud use:'
    puts "    rm \"#{build_path}\" && mkdir -p \"#{target}\" && ln -s \"#{target}\" \"#{build_path}\""
    puts ''
    return
  end

  if File.exist?(build_path)
    puts ''
    puts '[!] build/ ya existe como carpeta (no symlink). iCloud puede romper codesign en native_assets.'
    puts '    Cierra Xcode, luego ejecuta una sola vez:'
    puts "    rm -rf \"#{build_path}\" && mkdir -p \"#{target}\" && ln -s \"#{target}\" \"#{build_path}\""
    puts ''
    return
  end

  FileUtils.mkdir_p(target)
  File.symlink(target, build_path)
  puts "[!] Creado build/ -> #{target} (recomendado con proyecto en Documents/iCloud)."
end

ensure_flutter_build_outside_icloud

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Xcode 16+ simulators reject very old deployment targets (warnings / build issues).
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || current.to_s.empty? || current.to_f < 14.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      end
    end
    flutter_additional_ios_build_settings(target)
  end
end
